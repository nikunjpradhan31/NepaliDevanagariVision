# Server Configuration
HOST=0.0.0.0
PORT=10007
LOG_LEVEL=INFO
ENVIRONMENT=development
DEBUG=False
RELOAD=False

# Model Paths
MODELS_DIR=models

# Model Download URLs (downloaded into the container on startup)
DETECTION_MODEL_URL=https://github.com/nikunjpradhan31/NepaliDevanagariVision/releases/download/v2/LineDetectionv4.onnx
RECOGNITION_MODEL_URL=https://github.com/nikunjpradhan31/NepaliDevanagariVision/releases/download/v2/ResNetBiLSTMAttn_Dynamic_int8.onnx
MODEL_DOWNLOAD_TIMEOUT=300

# Detection Model
DETECTION_MODEL_DATA={"model_name":"LineDetectionv4","type":"detection","version":"4.0","model_file":"models/LineDetectionv4.onnx"}

# Recognition Model
RECOGNITION_MODEL_DATA={"model_name":"ResNetBiLSTMAttn_Dynamic_int8","type":"recognition","version":"2.0","model_file":"models/ResNetBiLSTMAttn_Dynamic_int8.onnx","decoder":"Attn", "max_batch_size": 16, "is_dynamic": true}

# Batch Processing
RECOGNITION_MAX_BATCH_SIZE=16

# Processing Configuration
DETECTION_CONFIDENCE_THRESHOLD=0.5
CROP_PADDING_X=100
CROP_PADDING_Y=15
MAX_FILE_SIZE=10485760

# Request Timeouts
REALTIME_REQUEST_TIMEOUT=5

# Security
ALLOWED_ORIGINS=["http://localhost:3000"]

# Image Processing
ALLOWED_IMAGE_EXTENSIONS=["jpg","jpeg","png","tiff","tif","pdf"]
TEMP_DIR=/tmp/ocr_temp
CLEANUP_TEMP_FILES=True

# Device Configuration
PREFERRED_DEVICE=cpu
FORCE_CPU=False

# Health Checks
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_INTERVAL=60

# Model Input Sizes
DETECTION_INPUT_SIZE=[1024,1024]
RECOGNITION_INPUT_SIZE=[1220,80]

# Character Set (Recognition)
RECOGNITION_CHARACTER_SET='०१२३४५६७८९0123456789!"#$%&\'()*+,-./:;<=>?@[\\]^_`{}~।॥—‘’“”… अआइईउऊऋएऐओऔअंअःकखगघङचछजझञटठडढणतथदधनपफबभमयरलवशषसहक्षत्रज्ञािीुूृेैोौंःँॅॉ'
